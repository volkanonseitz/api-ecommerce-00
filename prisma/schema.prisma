// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums from Laravel migrations
enum OrderStatus {
  pending
  processing
  completed
  cancelled
  failed
  refunded
}

enum PaymentStatus {
  pending
  due
  partial_due
  paid
  refunded
  cashed_out
}

enum CouponType {
  fixed_coupon
  percent_coupon
}

enum RefundStatus {
  pending
  approved
  rejected
}

enum RefundPolicyTarget {
  vendor
}

enum ProductStatus {
  draft
  publish
}

enum ProductVisibility {
  public
  password
}

enum ProductType {
  simple
  variable
}

enum NoticePriority {
  low
  medium
  high
}

enum NoticeType {
  info
  warning
  danger
}

enum ResourceType {
  dropoff
  pickup
  feature
  deposit
  person
}

enum OwnershipTransferStatus {
  pending
  approved
  rejected
}

enum WithdrawStatus {
  pending
  approved
  rejected
}

// Models
model User {
  id                      String    @id @default(uuid())
  name                    String
  email                   String    @unique
  emailVerifiedAt         DateTime? @map("email_verified_at")
  password                String
  rememberToken           String?   @map("remember_token")
  isActive                Boolean   @default(true) @map("is_active")
  shopId                  String?   @map("shop_id") // Foreign Key to Shop
  failedLoginAttempts     Int       @default(0) @map("failed_login_attempts")
  lockedUntil             DateTime? @map("locked_until")
  lastLoginAt             DateTime? @map("last_login_at")
  lastLoginIp             String?   @map("last_login_ip") @db.VarChar(45)
  lastLoginUserAgent      String?   @map("last_login_user_agent") @db.VarChar(1000)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  // Relations
  profile                 UserProfile?
  shopsOwned              Shop[]    @relation("ShopOwner")
  orders                  Order[]   @relation("CustomerOrders")
  addresses               Address[]
  reviews                 Review[]
  questions               Question[]
  wishlists               Wishlist[]
  messages                Message[]
  conversations           Conversation[]
  paymentGateways         PaymentGateway[]
  wallets                 Wallet[]
  feedbacks               Feedback[]
  abusiveReports          AbusiveReport[]
  providers               Provider[]
  userSessions            UserSession[]
  passwordHistory         PasswordHistory[]
  notifyLogsReceiver      NotifyLog[] @relation("NotifyLogReceiver")
  notifyLogsSender        NotifyLog[] @relation("NotifyLogSender")
  storeNoticesCreated     StoreNotice[] @relation("StoreNoticeCreatedBy")
  storeNoticesUpdated     StoreNotice[] @relation("StoreNoticeUpdatedBy")
  ownershipTransfersFrom  OwnershipTransfer[] @relation("OwnershipTransferFromUser")
  ownershipTransfersTo    OwnershipTransfer[] @relation("OwnershipTransferToUser")
  ownershipTransfersBy    OwnershipTransfer[] @relation("OwnershipTransferCreatedBy")
  coupons                 Coupon[]
  storeNoticeReads        StoreNoticeRead[]
  orderWalletPoints       OrderWalletPoint[]
  // User has many relationships through pivot tables (e.g., user_shop)
  userShops               UserShop[]
}

model UserProfile {
  id        String    @id @default(uuid())
  avatar    Json?
  bio       String?
  socials   Json?
  contact   String?
  notifications Json?
  customerId String    @unique @map("customer_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user      User      @relation(fields: [customerId], references: [id])
  @@map("user_profiles")
}

model Shop {
  id              String    @id @default(uuid())
  ownerId         String    @map("owner_id")
  name            String?
  slug            String?   @unique
  description     String?
  coverImage      Json?     @map("cover_image")
  logo            Json?
  isActive        Boolean   @default(false) @map("is_active")
  address         Json?
  settings        Json?
  notifications   Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  owner           User      @relation("ShopOwner", fields: [ownerId], references: [id])
  products        Product[]
  orders          Order[]
  attributes      Attribute[]
  balance         Balance?
  conversations   Conversation[]
  coupons         Coupon[]
  flashSales      FlashSale[]
  refunds         Refund[]
  withdraws       Withdraw[]
  faqs            Faq[]
  termsAndConditions TermAndCondition[]
  storeNotices    StoreNotice[]
  categoryShops   CategoryShop[]
  userShops       UserShop[]
  storeNoticeShops StoreNoticeShop[]
  refundPolicies  RefundPolicy[]
  @@map("shops")
}

model Product {
  id                        String    @id @default(uuid())
  name                      String
  slug                      String    @unique
  description               String?
  typeId                    String    @map("type_id") // FK to Type
  price                     Float?
  shopId                    String?   @map("shop_id") // FK to Shop
  authorId                  String?   @map("author_id") // FK to Author
  manufacturerId            String?   @map("manufacturer_id") // FK to Manufacturer
  isDigital                 Boolean   @default(false) @map("is_digital")
  isExternal                Boolean   @default(false) @map("is_external")
  externalProductUrl        String?   @map("external_product_url")
  externalProductButtonText String?   @map("external_product_button_text")
  blockedDates              String?   @map("blocked_dates") // Assuming JSON string
  salePrice                 Float?    @map("sale_price")
  language                  String
  minPrice                  Float?    @map("min_price")
  maxPrice                  Float?    @map("max_price")
  sku                       String?
  quantity                  Int       @default(0)
  soldQuantity              Int       @default(0) @map("sold_quantity")
  inStock                   Boolean   @default(true) @map("in_stock")
  isTaxable                 Boolean   @default(false) @map("is_taxable")
  inFlashSale               Int       @default(0) @map("in_flash_sale") // Laravel uses int for boolean here
  shippingClassId           String?   @map("shipping_class_id") // FK to ShippingClass
  status                    ProductStatus
  visibility                ProductVisibility
  productType               ProductType @map("product_type")
  unit                      String
  height                    String?
  width                     String?
  length                    String?
  image                     Json?
  video                     Json?
  gallery                   Json?
  deletedAt                 DateTime? @map("deleted_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  // Relations
  type                      Type      @relation(fields: [typeId], references: [id])
  shop                      Shop?     @relation(fields: [shopId], references: [id])
  author                    Author?   @relation(fields: [authorId], references: [id])
  manufacturer              Manufacturer? @relation(fields: [manufacturerId], references: [id])
  shippingClass             ShippingClass? @relation(fields: [shippingClassId], references: [id])
  variationOptions          VariationOption[]
  reviews                   Review[]
  questions                 Question[]
  wishlists                 Wishlist[]
  digitalFiles              DigitalFile[] @relation("DigitalFileProduct")
  // Polymorphic relations: resources (multiple pivots), products_meta
  // Pivots: category_product, product_tag, attribute_product, flash_sale_products, flash_sale_requests_products
  categoryProducts          CategoryProduct[]
  productTags               ProductTag[]
  attributeProducts         AttributeProduct[]
  flashSaleProducts         FlashSaleProduct[]
  flashSaleRequestsProducts FlashSaleRequestsProduct[]
  productsMeta              ProductMeta[]
  orderProducts             OrderProduct[]
  availabilities            Availability[]
  dropoffLocationProducts   DropoffLocationProduct[]
  pickupLocationProducts    PickupLocationProduct[]
  featureProducts           FeatureProduct[]
  depositProducts           DepositProduct[]
  personProducts            PersonProduct[]

  @@map("products")
}

model VariationOption {
  id        String    @id @default(uuid())
  title     String
  image     Json?
  isDigital Boolean   @default(false) @map("is_digital")
  price     String // Assuming string due to Laravel float/double inconsistencies, can be Float
  salePrice String?   @map("sale_price") // Assuming string, can be Float
  language  String
  quantity  BigInt
  soldQuantity Int    @default(0) @map("sold_quantity")
  isDisable Boolean   @default(false) @map("is_disable")
  sku       String?
  options   Json // JSON type for variations options
  productId String?   @map("product_id") // FK to Product
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  product   Product?  @relation(fields: [productId], references: [id])
  reviews   Review[]
  wishlists Wishlist[]
  orderProducts OrderProduct[]

  @@map("variation_options")
}

model ProductMeta {
  id        Int      @id @default(autoincrement())
  productId String   @map("product_id")
  type      String   @default("null")
  key       String
  value     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product   Product  @relation(fields: [productId], references: [id])

  @@index([key])
  @@map("products_meta")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  language    String
  icon        String?
  image       Json?
  bannerImage Json?     @map("banner_image")
  details     String?   @db.Text
  parentId    String?   @map("parent_id") // Self-referencing FK
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  parent      Category? @relation("SubCategories", fields: [parentId], references: [id])
  subCategories Category[] @relation("SubCategories")
  categoryProducts CategoryProduct[]
  categoryShops CategoryShop[]

  @@map("categories")
}

model Order {
  id               String      @id @default(uuid())
  trackingNumber   String      @unique @map("tracking_number")
  customerId       String?     @map("customer_id") // FK to User
  customerContact  String      @map("customer_contact")
  customerName     String?     @map("customer_name")
  amount           Float
  salesTax         Float?      @map("sales_tax")
  paidTotal        Float?      @map("paid_total")
  total            Float?
  note             String?     @db.LongText
  language         String
  cancelledAmount  Decimal     @default(0) @map("cancelled_amount") @db.Decimal(65, 30) // Assuming Decimal(8,2) from Laravel
  cancelledTax     Decimal     @default(0) @map("cancelled_tax") @db.Decimal(65, 30)
  cancelledDeliveryFee Decimal   @default(0) @map("cancelled_delivery_fee") @db.Decimal(65, 30)
  couponId         String?     @map("coupon_id") // FK to Coupon (Laravel migration says bigint, no FK constraint)
  parentId         String?     @map("parent_id") // Self-referencing FK
  shopId           String?     @map("shop_id") // FK to Shop
  discount         Float?
  paymentGateway   String?     @map("payment_gateway")
  alteredPaymentGateway String? @map("altered_payment_gateway")
  shippingAddress  Json?       @map("shipping_address")
  billingAddress   Json?       @map("billing_address")
  logisticsProvider BigInt?     @map("logistics_provider") // Assuming bigint here for external ID
  deliveryFee      Float?      @map("delivery_fee")
  deliveryTime     String?     @map("delivery_time")
  orderStatus      OrderStatus @map("order_status")
  paymentStatus    PaymentStatus @map("payment_status")
  deletedAt        DateTime?   @map("deleted_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  // Relations
  customer         User?       @relation("CustomerOrders", fields: [customerId], references: [id])
  shop             Shop?       @relation(fields: [shopId], references: [id])
  coupon           Coupon?     @relation(fields: [couponId], references: [id])
  parent           Order?      @relation("SubOrders", fields: [parentId], references: [id])
  subOrders        Order[]     @relation("SubOrders")
  orderProducts    OrderProduct[]
  refunds          Refund[]
  paymentIntents   PaymentIntent[]
  orderedFiles     OrderedFile[]
  availabilities   Availability[]
  orderWalletPoints OrderWalletPoint[]

  @@map("orders")
}

model Coupon {
  id                  String      @id @default(uuid())
  code                String
  language            String
  description         String?     @db.Text
  image               Json?
  type                CouponType
  amount              Float       @default(0)
  minimumCartAmount   Float       @default(0) @map("minimum_cart_amount")
  activeFrom          String      @map("active_from") // Assuming string for date, can be DateTime
  expireAt            String      @map("expire_at") // Assuming string for date, can be DateTime
  target              Boolean     @default(false)
  isApprove           Boolean     @default(false) @map("is_approve")
  shopId              String?     @map("shop_id") // FK to Shop
  userId              String?     @map("user_id") // FK to User
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  deletedAt           DateTime?   @map("deleted_at")

  shop                Shop?       @relation(fields: [shopId], references: [id])
  user                User?       @relation(fields: [userId], references: [id])
  orders              Order[]

  @@map("coupons")
}

model Refund {
  id             String      @id @default(uuid())
  amount         Float       @default(0)
  status         RefundStatus
  title          String?
  description    String?     @db.Text
  images         Json?
  orderId        String?     @map("order_id") // FK to Order
  customerId     String?     @map("customer_id") // FK to User
  refundPolicyId String?     @map("refund_policy_id") // FK to RefundPolicy
  shopId         String?     @map("shop_id") // FK to Shop
  refundReasonId String?     @map("refund_reason_id") // FK to RefundReason
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  order          Order?      @relation(fields: [orderId], references: [id])
  customer       User?       @relation(fields: [customerId], references: [id])
  refundPolicy   RefundPolicy? @relation(fields: [refundPolicyId], references: [id])
  shop           Shop?       @relation(fields: [shopId], references: [id])
  refundReason   RefundReason? @relation(fields: [refundReasonId], references: [id])

  @@map("refunds")
}

model RefundReason {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  language  String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  refunds   Refund[]

  @@map("refund_reasons")
}

model RefundPolicy {
  id          String              @id @default(uuid())
  title       String
  slug        String              @unique
  description String?             @db.Text
  target      RefundPolicyTarget
  language    String
  status      RefundStatus
  shopId      String?             @map("shop_id") // FK to Shop
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  deletedAt   DateTime?           @map("deleted_at")

  shop        Shop?               @relation(fields: [shopId], references: [id])
  refunds     Refund[]

  @@map("refund_policies")
}

model Review {
  id                 String        @id @default(uuid())
  orderId            String?       @map("order_id") // FK to Order
  userId             String        @map("user_id") // FK to User
  shopId             String        @map("shop_id") // FK to Shop
  productId          String        @map("product_id") // FK to Product
  variationOptionId  String?       @map("variation_option_id") // FK to VariationOption
  comment            String        @db.LongText
  rating             Float?
  photos             Json?
  deletedAt          DateTime?     @map("deleted_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  order              Order?        @relation(fields: [orderId], references: [id])
  user               User          @relation(fields: [userId], references: [id])
  shop               Shop          @relation(fields: [shopId], references: [id])
  product            Product       @relation(fields: [productId], references: [id])
  variationOption    VariationOption? @relation(fields: [variationOptionId], references: [id])

  @@map("reviews")
}

model Question {
  id        String    @id @default(uuid())
  userId    String    @map("user_id") // FK to User
  shopId    String    @map("shop_id") // FK to Shop
  productId String    @map("product_id") // FK to Product
  question  String    @db.Text
  answer    String?   @db.Text
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id])
  shop      Shop      @relation(fields: [shopId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@map("questions")
}

model Feedback {
  id          String    @id @default(uuid())
  userId      String    @map("user_id") // FK to User
  modelType   String    @map("model_type") // Polymorphic
  modelId     String    @map("model_id") // Polymorphic
  positive    Boolean?
  negative    Boolean?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User      @relation(fields: [userId], references: [id])

  @@map("feedbacks")
}

model AbusiveReport {
  id          String    @id @default(uuid())
  userId      String    @map("user_id") // FK to User
  modelType   String    @map("model_type") // Polymorphic
  modelId     String    @map("model_id") // Polymorphic
  message     String    @db.VarChar(1000)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, modelType, modelId])
  @@map("abusive_reports")
}

model Wishlist {
  id                String    @id @default(uuid())
  userId            String    @map("user_id") // FK to User
  productId         String    @map("product_id") // FK to Product
  variationOptionId String?   @map("variation_option_id") // FK to VariationOption
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user              User      @relation(fields: [userId], references: [id])
  product           Product   @relation(fields: [productId], references: [id])
  variationOption   VariationOption? @relation(fields: [variationOptionId], references: [id])

  @@map("wishlists")
}

model Address {
  id          String    @id @default(uuid())
  title       String
  type        String
  default     Boolean   @default(false)
  address     Json
  location    Json?
  customerId  String    @map("customer_id") // FK to User
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  customer    User      @relation(fields: [customerId], references: [id])

  @@map("address")
}

model PaymentGateway {
  id         String    @id @default(uuid())
  userId     String    @map("user_id") // FK to User
  customerId String    @map("customer_id") // External customer ID, e.g., Stripe customer ID
  gatewayName String?   @map("gateway_name")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user       User      @relation(fields: [userId], references: [id])
  paymentMethods PaymentMethod[]

  @@map("payment_gateways")
}

model PaymentMethod {
  id              String    @id @default(uuid())
  methodKey       String    @unique @map("method_key")
  methodType      String?   @map("method_type")
  brand           String?
  paymentGatewayId String?   @map("payment_gateway_id") // FK to PaymentGateway
  defaultPayment  Boolean?  @default(false) @map("default_payment")
  fingerprint     String    @unique
  ownerName       String?   @map("owner_name")
  network         String?
  type            String?
  last4           String?
  expMonth        String?   @map("exp_month")
  expYear         String?   @map("exp_year")
  expires         String? // Original 'expires' column
  origin          String?
  verificationCheck String? @map("verification_check")
  providerData    Json?     @map("provider_data")
  metadata        Json?
  qrisUrl         String?   @map("qris_url")
  vaNumber        String?   @map("va_number")
  bankCode        String?   @map("bank_code")
  ewalletType     String?   @map("ewallet_type")
  directDebitType String?   @map("direct_debit_type")
  accountName     String?   @map("account_name")
  accountNumber   String?   @map("account_number")
  accountLast4    String?   @map("account_last4")
  expiryDate      DateTime? @map("expiry_date")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  paymentGateway  PaymentGateway? @relation(fields: [paymentGatewayId], references: [id])

  @@map("payment_methods")
}

model PaymentIntent {
  id               String    @id @default(uuid())
  orderId          String?   @map("order_id") // FK to Order
  trackingNumber   String?   @map("tracking_number") // Not FK in Laravel, but related to Order
  paymentGateway   String?   @map("payment_gateway")
  paymentIntentInfo Json?     @map("payment_intent_info")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  order            Order?    @relation(fields: [orderId], references: [id])

  @@map("payment_intents")
}

model Balance {
  id                   String    @id @default(uuid())
  shopId               String    @unique @map("shop_id") // FK to Shop (one-to-one or one-to-many depending on use)
  adminCommissionRate  Float?    @map("admin_commission_rate")
  totalEarnings        Float     @default(0) @map("total_earnings")
  withdrawnAmount      Float     @default(0) @map("withdrawn_amount")
  currentBalance       Float     @default(0) @map("current_balance")
  isCustomCommission   Boolean   @default(false) @map("is_custom_commission")
  paymentInfo          Json?     @map("payment_info")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  shop                 Shop      @relation(fields: [shopId], references: [id])

  @@map("balances")
}

model Wallet {
  id             String    @id @default(uuid())
  totalPoints    Float     @default(0) @map("total_points")
  pointsUsed     Float     @default(0) @map("points_used")
  availablePoints Float     @default(0) @map("available_points")
  customerId     String?   @map("customer_id") // FK to User
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  customer       User?     @relation(fields: [customerId], references: [id])

  @@map("wallets")
}

model OrderWalletPoint {
  id        String    @id @default(uuid())
  amount    Float?
  orderId   String?   @map("order_id") // FK to Order
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  order     Order?    @relation(fields: [orderId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  userId    String // FK to User
  @@map("order_wallet_points")
}

model Withdraw {
  id            String      @id @default(uuid())
  shopId        String      @map("shop_id") // FK to Shop
  amount        Float
  paymentMethod String?     @map("payment_method")
  status        WithdrawStatus
  details       String?     @db.Text
  note          String?     @db.Text
  deletedAt     DateTime?   @map("deleted_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  shop          Shop        @relation(fields: [shopId], references: [id])

  @@map("withdraws")
}

model Commission {
  id          String    @id @default(uuid())
  level       String
  subLevel    String    @map("sub_level")
  description String    @db.Text
  minBalance  Int       @map("min_balance")
  maxBalance  String    @map("max_balance") // Assuming string from Laravel for flexible range
  commission  Float
  image       Json?
  language    String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("commissions")
}

model TaxClass {
  id          String    @id @default(uuid())
  country     String?
  state       String?
  zip         String?
  city        String?
  rate        Float
  name        String?
  isGlobal    Int?      @map("is_global") // Laravel uses int for boolean
  priority    Int?
  onShipping  Boolean   @default(true) @map("on_shipping")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("tax_classes")
}

model ShippingClass {
  id          String    @id @default(uuid())
  name        String
  amount      Float
