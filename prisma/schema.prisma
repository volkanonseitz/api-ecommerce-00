// Pivot / Junction Tables

model OrderProduct {
  id                String    @id @default(uuid())
  orderId           String    @map("order_id")
  productId         String    @map("product_id")
  variationOptionId String?   @map("variation_option_id")
  orderQuantity     String    @map("order_quantity") // Assuming string from Laravel for flexible quantity types
  unitPrice         Float     @map("unit_price")
  subtotal          Float
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  order             Order     @relation(fields: [orderId], references: [id])
  product           Product   @relation(fields: [productId], references: [id])
  variationOption   VariationOption? @relation(fields: [variationOptionId], references: [id])

  @@map("order_product")
}

model CategoryProduct {
  id         String    @id @default(uuid()) // Laravel has bigint, using String for consistency
  productId  String    @map("product_id")
  categoryId String    @map("category_id")

  product    Product   @relation(fields: [productId], references: [id])
  category   Category  @relation(fields: [categoryId], references: [id])

  @@map("category_product")
}

model ProductTag {
  id        String    @id @default(uuid()) // Laravel has bigint, using String for consistency
  productId String    @map("product_id")
  tagId     String    @map("tag_id")

  product   Product   @relation(fields: [productId], references: [id])
  tag       Tag       @relation(fields: [tagId], references: [id])

  @@map("product_tag")
}

model UserShop {
  id        String    @id @default(uuid()) // Laravel has bigint, using String for consistency
  userId    String    @map("user_id")
  shopId    String    @map("shop_id")
  createdAt DateTime  @default(now()) @map("created_at") // Added for consistency, if not in migration
  updatedAt DateTime  @updatedAt @map("updated_at") // Added for consistency, if not in migration

  user      User      @relation(fields: [userId], references: [id])
  shop      Shop      @relation(fields: [shopId], references: [id])

  @@unique([userId, shopId]) // Assuming unique combination
  @@map("user_shop")
}

model CategoryShop {
  id         String    @id @default(uuid()) // Laravel has bigint, using String for consistency
  shopId     String    @map("shop_id")
  categoryId String    @map("category_id")
  createdAt DateTime  @default(now()) @map("created_at") // Added for consistency, if not in migration
  updatedAt DateTime  @updatedAt @map("updated_at") // Added for consistency, if not in migration

  shop       Shop      @relation(fields: [shopId], references: [id])
  category   Category  @relation(fields: [categoryId], references: [id])

  @@unique([shopId, categoryId]) // Assuming unique combination
  @@map("category_shop")
}

