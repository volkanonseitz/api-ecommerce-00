model ModelHasPermission {
  permissionId String @map("permission_id")
  modelType    String @map("model_type")
  modelId      String @map("model_id") // Assuming String for BigInt
  
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([permissionId, modelId, modelType]) // Composite Primary Key
  @@map("model_has_permissions")
}

model ModelHasRole {
  roleId    String @map("role_id")
  modelType String @map("model_type")
  modelId   String @map("model_id") // Assuming String for BigInt

  role      Role   @relation(fields: [roleId], references: [id])

  @@id([roleId, modelId, modelType]) // Composite Primary Key
  @@map("model_has_roles")
}

model RoleHasPermission {
  permissionId String @map("permission_id")
  roleId       String @map("role_id")

  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([permissionId, roleId]) // Composite Primary Key
  @@map("role_has_permissions")
}

